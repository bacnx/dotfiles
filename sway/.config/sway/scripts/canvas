#!/bin/sh
# canvas — wide gaps around a workspace's windows, so they sit in the middle
# with the wallpaper around them. Per workspace; the others keep their gaps.
#
#   canvas toggle   turn it on/off for the focused workspace ($mod+g)
#   canvas watch    keep canvas workspaces fitted as windows come and go
#                   (canvas.service, part of sway-session.target)
#
# The side gaps follow the number of columns, so side-by-side windows get
# more of the width than a single one. The watcher refits on every window
# open/close/move, workspace switch and key binding (e.g. $mod+e, $mod+v).
set -eu

# Normal gaps: keep in step with `gaps inner` / `gaps outer` in sway's config.
inner=6
outer=2
# Canvas gaps. Top/bottom is fixed; left/right by columns: 1, 2, 3 or more.
canvas_inner=16
canvas_y=90
canvas_x_1=280
canvas_x_2=160
canvas_x_3=60

# Names of the workspaces in canvas mode, one per line. Cleared by `watch`
# at session start, since sway itself starts with normal gaps.
state=${XDG_RUNTIME_DIR:-/tmp}/sway-canvas

# Focused workspace and its number of columns: unwrap containers holding a
# single child; a horizontal split counts its children, any other layout
# (vertical, tabbed, stacked, one window) is one column.
focused() {
    swaymsg -t get_tree -r | jq -r '
        def cols: if (.nodes | length) == 1 and (.nodes[0].nodes | length) > 0
                  then .nodes[0] | cols
                  elif .layout == "splith" then ([.nodes | length, 1] | max)
                  else 1 end;
        first(.. | objects | select(.type == "workspace")
              | select(any(.. | objects; .focused)))
        | "\(.name)\t\(cols)"'
}

is_canvas() { [ -f "$state" ] && grep -qxF -- "$1" "$state"; }

fit() {  # fit <columns>: apply canvas gaps to the focused workspace
    case $1 in 1) x=$canvas_x_1 ;; 2) x=$canvas_x_2 ;; *) x=$canvas_x_3 ;; esac
    swaymsg -q "gaps inner current set $canvas_inner; \
        gaps horizontal current set $x; gaps vertical current set $canvas_y"
}

case ${1:-toggle} in
toggle)
    f=$(focused); ws=${f%%"	"*}; cols=${f##*"	"}
    if is_canvas "$ws"; then
        grep -vxF -- "$ws" "$state" > "$state.new" || true
        mv "$state.new" "$state"
        swaymsg -q "gaps inner current set $inner; gaps outer current set $outer"
    else
        printf '%s\n' "$ws" >> "$state"
        fit "$cols"
    fi
    ;;
watch)
    : > "$state"
    last=
    swaymsg -t subscribe -m '["window", "workspace", "binding"]' |
    jq --unbuffered -r 'select(.change | IN("new", "close", "move", "floating",
                                            "focus", "run")) | .change' |
    while read -r _; do
        [ -s "$state" ] || continue
        f=$(focused); ws=${f%%"	"*}
        is_canvas "$ws" || continue
        # Window focus changes fire often; only refit when the shape changed.
        [ "$f" = "$last" ] && continue
        last=$f
        fit "${f##*"	"}"
    done
    ;;
*)
    echo "usage: canvas [toggle|watch]" >&2; exit 2 ;;
esac
