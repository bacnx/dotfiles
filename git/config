# Shared git settings, linked as ~/.config/git/config. Git reads this before
# ~/.gitconfig, which stays untracked and holds what belongs to one machine:
# [user], employer [url] rewrites, includeIf identities.
[core]
	editor = nvim
	pager = delta

[interactive]
	diffFilter = delta --color-only

# catppuccin/delta, vendored; relative to this file. Its syntax-theme needs
# bat/themes/Catppuccin Mocha.tmTheme in bat's cache (see README).
[include]
	path = catppuccin.gitconfig

[delta]
	features = catppuccin-mocha
	navigate = true  # use n and N to move between diff sections
	dark = true      # or `light = true`, or omit for auto-detection
	line-numbers = true

[merge]
	conflictStyle = zdiff3
