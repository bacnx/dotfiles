// Waybar — Catppuccin Mocha. Styling lives in style.css.
{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 4,

    "modules-left":   ["sway/workspaces", "sway/mode", "sway/window"],
    "modules-center": ["custom/network", "custom/vpn"],
    "modules-right":  ["group/systray", "cpu", "memory", "temperature", "pulseaudio", "clock"],

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}"
    },

    "sway/mode": {
        "format": "󰩨 {}"
    },

    // Title of the focused window; hidden on an empty workspace.
    "sway/window": {
        "format": "{title}",
        "max-length": 70,
        "icon": false,
        "tooltip": false
    },

    "clock": {
        "format": "󰥔  {:%H:%M}",
        "format-alt": "󰃭  {:%a %d %b %Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "",
            "format": {
                "months":   "<span color='#cba6f7'><b>{}</b></span>",
                "weekdays": "<span color='#fab387'><b>{}</b></span>",
                "days":     "<span color='#cdd6f4'>{}</span>",
                "today":    "<span color='#f38ba8'><b><u>{}</u></b></span>"
            }
        }
    },

    "cpu": {
        "interval": 3,
        "format": "󰻠  {usage}%",
        "states": { "warning": 70, "critical": 90 }
    },

    "memory": {
        "interval": 5,
        "format": "󰍛  {percentage}%",
        "tooltip-format": "{used:0.1f} / {total:0.1f} GiB used",
        "states": { "warning": 75, "critical": 90 }
    },

    // coretemp's hwmonN number can change between boots, so match by device path.
    "temperature": {
        "interval": 5,
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp1_input",
        "critical-threshold": 80,
        "format": "󰔏  {temperatureC}°C",
        "format-critical": "󰸁  {temperatureC}°C"
    },

    "pulseaudio": {
        "scroll-step": 5,
        "format": "{icon}  {volume}%",
        "format-muted": "󰝟  muted",
        "format-icons": { "headphone": "󰋋", "default": ["󰕿", "󰖀", "󰕾"] },
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    // Physical card in use: with wifi and LAN both up, only the one carrying the
    // default route (lowest metric) is shown. VPN tunnels get their own module so
    // split-tunnel setups show the real uplink and every tunnel side by side.
    // Hidden while no VPN is up, unless offline or without an IP.
    // Compact (icon only) by default; left-click on either module toggles the
    // IPs on both, right-click opens the connection editor.
    "custom/network": {
        "exec": "~/.config/waybar/scripts/network.sh phys",
        "return-type": "json",
        "interval": 5,
        "signal": 8,
        "on-click": "~/.config/waybar/scripts/network.sh toggle",
        "on-click-right": "nm-connection-editor"
    },

    // Every VPN that is up, by name (and IP when toggled on); the tooltip has
    // the IP and routed subnets. Hidden when no tunnel is up.
    "custom/vpn": {
        "exec": "~/.config/waybar/scripts/network.sh vpn",
        "return-type": "json",
        "interval": 5,
        "signal": 8,
        "on-click": "~/.config/waybar/scripts/network.sh toggle",
        "on-click-right": "nm-connection-editor"
    },

    // Tray icons folded behind an arrow: click the arrow to show them (they
    // slide out to its left), click again to hide. Starts folded.
    "group/systray": {
        "orientation": "inherit",
        "drawer": {
            "click-to-reveal": true,
            "transition-duration": 300,
            "transition-left-to-right": false,
            "children-class": "systray-child"
        },
        "modules": ["custom/tray-arrow", "tray"]
    },

    "custom/tray-arrow": {
        "format": "󰅁",
        "tooltip": false
    },

    "tray": {
        "icon-size": 16,
        "spacing": 10
    }
}
