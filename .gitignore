# TPM clones plugins into ~/.config/tmux/plugins, which is symlinked into this repo
tmux/.config/tmux/plugins/

# Machine-specific sway config (outputs/inputs), kept local
sway/.config/sway/config.d/

# Built by `dothelp` from keymaps.toml
docs/keymaps.json

# Claude Code writes type declarations into each mod it loads
claude/.claude/mods/*/.claude-plugin/types/
claude/.claude/mods/*/tsconfig.json
